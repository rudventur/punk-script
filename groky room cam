<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>WiFi Room Mapper v2.1 • Camera Ready</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.134.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.134.0/examples/js/controls/DragControls.js"></script>
    <style>
        body { margin:0; overflow:hidden; font-family: 'Segoe UI', sans-serif; background:#111; color:#fff; }
        canvas { display:block; }
        #ui { position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; }
        .panel { pointer-events:auto; background:rgba(20,20,30,0.95); border:1px solid #444; border-radius:12px; padding:15px; box-shadow:0 10px 30px rgba(0,0,0,0.6); }
        #left-panel { position:absolute; top:20px; left:20px; width:280px; }
        button { background:#00ddff; color:#000; border:none; padding:10px 16px; margin:4px; border-radius:8px; font-weight:bold; cursor:pointer; }
        button:hover { background:#00ffff; }
        button.danger { background:#ff5555; }
        #camera-controls { position:absolute; bottom:20px; left:50%; transform:translateX(-50%); display:flex; gap:10px; pointer-events:auto; }
        #toast { position:absolute; bottom:80px; left:50%; transform:translateX(-50%); background:#00ddff; color:#000; padding:12px 24px; border-radius:9999px; font-weight:bold; display:none; }
        video { display:none; } /* hidden video element for stream */
    </style>
</head>
<body>
<div id="ui">
    <!-- LEFT PANEL (same as before, abbreviated) -->
    <div id="left-panel" class="panel">
        <h2>🛠️ WiFi Room Mapper v2.1</h2>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <button onclick="addRoom()">+ New Room</button>
            <button onclick="addFurniture()">+ Furniture</button>
            <button onclick="addWifiPin()">+ WiFi Pin</button>
            <button onclick="simulateSignal()">📡 Simulate</button>
        </div>
        <div id="properties" class="panel" style="display:none; margin-top:15px;">
            <!-- properties content same as previous version -->
            <div class="close-btn" onclick="deselectObject()">✕</div>
            <h3 id="prop-title">Selected Object</h3>
            <!-- width/depth/height sliders here (copy from previous) -->
        </div>
    </div>

    <!-- CAMERA CONTROLS -->
    <div id="camera-controls">
        <button onclick="toggleCamera()">📷 Toggle Camera Background</button>
        <button onclick="captureFrame()">📸 Capture Frame (for scan)</button>
        <button onclick="stopCamera()" class="danger">Stop Camera</button>
    </div>

    <!-- TOAST -->
    <div id="toast"></div>
</div>

<video id="video" autoplay playsinline></video>

<script>
// ==================== THREE.JS SETUP (same core as before) ====================
let scene, camera, renderer, controls, dragControls;
let videoTexture, videoElement, cameraStream;
let cameraEnabled = false;
let allObjects = [], floorMeshes = [], wifiPins = [], currentRooms = [];
let selectedObject = null;

const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();

async function initThree() {
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x112233); // will be replaced by video when camera on

    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(15, 18, 25);

    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    document.body.appendChild(renderer.domElement);

    // Lights + outside world (same as before)
    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const dirLight = new THREE.DirectionalLight(0xffeecc, 1);
    dirLight.position.set(20, 40, 10);
    scene.add(dirLight);

    addOutsideWorld();

    controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;

    // Video element for camera
    videoElement = document.getElementById('video');

    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    });

    document.addEventListener('click', onClick);
    createRoom(0, 0); // default room
    initDragControls();
    animate();
}

function animate() {
    requestAnimationFrame(animate);
    controls.update();
    if (videoTexture) videoTexture.needsUpdate = true; // important for live video
    renderer.render(scene, camera);
}

// ==================== CAMERA INTEGRATION (refined) ====================
async function startCamera(facingMode = 'environment') { // rear camera by default
    try {
        if (cameraStream) cameraStream.getTracks().forEach(track => track.stop());

        const constraints = {
            video: {
                facingMode: facingMode,
                width: { ideal: 1280 },
                height: { ideal: 720 }
            }
        };

        cameraStream = await navigator.mediaDevices.getUserMedia(constraints);
        videoElement.srcObject = cameraStream;
        await videoElement.play();

        // Create VideoTexture for Three.js
        videoTexture = new THREE.VideoTexture(videoElement);
        videoTexture.minFilter = THREE.LinearFilter;
        videoTexture.magFilter = THREE.LinearFilter;

        // Set as scene background (nice AR-like feel)
        scene.background = videoTexture;

        // Optional: add a semi-transparent plane in front if you want overlay effect
        cameraEnabled = true;
        showToast("✅ Camera started (rear) — move phone to scan room");
    } catch (err) {
        console.error(err);
        showToast("❌ Camera access denied or not available");
    }
}

function toggleCamera() {
    if (cameraEnabled) {
        stopCamera();
    } else {
        startCamera('environment'); // prefer rear for room scanning
    }
}

function stopCamera() {
    if (cameraStream) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
    }
    videoElement.srcObject = null;
    scene.background = new THREE.Color(0x112233); // reset to dark
    cameraEnabled = false;
    showToast("Camera stopped");
}

async function captureFrame() {
    if (!cameraEnabled || !videoElement.videoWidth) {
        showToast("Start camera first!");
        return;
    }

    // Create canvas snapshot
    const canvas = document.createElement('canvas');
    canvas.width = videoElement.videoWidth;
    canvas.height = videoElement.videoHeight;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(videoElement, 0, 0);

    const dataUrl = canvas.toDataURL('image/jpeg', 0.92);

    // For now: show toast. Later: send to Flutter or process locally
    showToast("📸 Frame captured! (Ready for photogrammetry)");

    // Example: you can store frames in array for future multi-view reconstruction
    window.capturedFrames = window.capturedFrames || [];
    window.capturedFrames.push(dataUrl);

    // Optional: add a small plane with this texture in the scene as reference
    const tex = new THREE.TextureLoader().load(dataUrl);
    const plane = new THREE.Mesh(
        new THREE.PlaneGeometry(8, 6),
        new THREE.MeshBasicMaterial({ map: tex, side: THREE.DoubleSide })
    );
    plane.position.set(0, 3, -10);
    scene.add(plane);
    allObjects.push(plane);
}

// ==================== REST OF THE CODE (drag, properties, signal, save etc.) ====================
// ... (copy the drag/select, addRoom, addFurniture, simulateSignal, save/load from previous version here) ...

// For brevity I'm not repeating the entire previous code — just paste the camera parts above into your existing file.
// Key improvements: facingMode preference, proper cleanup, live texture update, captureFrame ready for Flutter bridge.

// ==================== START ====================
initThree();

function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', 3000);
}

// Auto-save etc. remains the same
</script>
</body>
</html>
